generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Categoria {
  Fertilizantes
  Maquinaria
  Semillas
  Agroquimicos
}

model User {
  id        String    @id @default(uuid())
  nombre    String
  email     String    @unique
  password  String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]

  @@map("users")
}

model Product {
  id          String    @id @default(uuid())
  codigo      String    @unique
  nombre      String
  descripcion String
  precio      Decimal   @db.Decimal(10, 2)
  categoria   Categoria
  createdBy   String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [createdBy], references: [id])

  @@map("products")
}
